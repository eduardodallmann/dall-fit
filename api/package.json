{
  "name": "dall-fit-api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "configure:google-oauth": "node ./scripts/configure-google-oauth.mjs",
    "indexes:apply": "tsx ./scripts/apply-indexes.ts",
    "images:reconcile": "tsx ./scripts/reconcile-training-exercise-images.ts",
    "dev": "concurrently --kill-others --no-color --names infra,api \"pnpm dev:infra\" \"pnpm start:dev\"",
    "dev:infra": "node ./scripts/dev-infra.mjs",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "seed": "tsx test/seeds/cli.ts",
    "lint": "pnpm --dir .. exec eslint api",
    "lint:fix": "pnpm --dir .. exec eslint api --fix",
    "sonar": "dotenv -e ../.env -- sh -c 'test -n \"$SONAR_TOKEN\" || { echo \"Error: SONAR_TOKEN is required. See docs/sdd/base/02-workspace-e-qualidade.md\"; exit 1; }; pnpm test:coverage:ci && sonar-scanner-npm'",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:coverage:ci": "vitest run --coverage --reporter=default --reporter=junit --outputFile.junit=coverage/junit.xml",
    "test:debug": "vitest --inspect-brk --inspect --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dall-fit/types": "workspace:*",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/terminus": "^11.1.1",
    "@vercel/blob": "^2.7.0",
    "@vercel/functions": "^3.9.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "google-auth-library": "^10.9.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "mongoose": "^9.8.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.28",
    "@swc/core": "^1.15.46",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^10.0.4",
    "mongodb-memory-server": "^11.2.0",
    "redis-memory-server": "^0.17.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3",
    "unplugin-swc": "^1.5.9",
    "vitest": "^4.1.10"
  }
}
