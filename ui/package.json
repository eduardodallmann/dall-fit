{
  "name": "dall-fit-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "android:build:debug": "pnpm android:sync && ./android/gradlew -p android assembleDebug",
    "android:open": "cap open android",
    "android:run": "pnpm android:sync && cap run android",
    "android:sync": "pnpm build && cap sync android",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "capture:sdd": "playwright test --config playwright.sdd-screenshots.config.ts",
    "generate:pwa-assets": "pwa-assets-generator --preset minimal-2023 public/favicon.svg",
    "lint": "pnpm --dir .. exec eslint ui",
    "lint:fix": "pnpm --dir .. exec eslint ui --fix",
    "preview": "vite preview",
    "sonar": "dotenv -e ../.env -- sh -c 'test -n \"$SONAR_TOKEN\" || { echo \"Error: SONAR_TOKEN is required. See docs/sdd/base/02-workspace-e-qualidade.md\"; exit 1; }; pnpm test:coverage:ci && sonar-scanner-npm'",
    "test": "node tests/eslint/capacitor-boundary.mjs && vitest run",
    "test:integration": "playwright test",
    "test:integration:debug": "playwright test --debug",
    "test:integration:install": "playwright install chromium",
    "test:integration:install:ci": "playwright install --with-deps chromium",
    "test:integration:ui": "playwright test --ui",
    "test:pwa-update": "node tests/pwa-update/run.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:coverage:ci": "vitest run --coverage --reporter=default --reporter=junit --outputFile.junit=coverage/junit.xml",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/core": "8.5.2",
    "@dall-fit/types": "workspace:*",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@heroui/react": "^3.2.2",
    "@heroui/styles": "^3.2.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-form": "^1.33.2",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.18",
    "@vercel/analytics": "^2.0.1",
    "axios": "^1.18.1",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-player": "^3.4.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vite-pwa/assets-generator": "^1.0.2",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "typescript": "~6.0.3",
    "vite": "^8.1.5",
    "vite-plugin-pwa": "~1.3.0",
    "vitest": "^4.1.10",
    "workbox-window": "^7.4.1"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
