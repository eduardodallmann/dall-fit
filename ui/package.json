{
  "name": "dall-fit-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "android:build:debug": "pnpm android:sync && ./android/gradlew -p android assembleDebug && mv ./android/app/build/outputs/apk/debug/app-debug.apk ./android/app-debug.apk",
    "android:build:release": "node scripts/android-release.mjs",
    "android:open": "cap open android",
    "android:run": "pnpm android:sync && cap run android",
    "android:sync": "pnpm build && cap sync android",
    "android:test": "pnpm android:sync && ./android/gradlew -p android connectedDebugAndroidTest",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "capture:sdd": "playwright test --config playwright.sdd-screenshots.config.ts",
    "generate:pwa-assets": "pwa-assets-generator --preset minimal-2023 public/favicon.svg",
    "lint": "pnpm --dir .. exec eslint ui",
    "lint:fix": "pnpm --dir .. exec eslint ui --fix",
    "preview": "vite preview",
    "sonar": "dotenv -e ../.env -- sh -c 'test -n \"$SONAR_TOKEN\" || { echo \"Error: SONAR_TOKEN is required. See docs/sdd/base/02-workspace-e-qualidade.md\"; exit 1; }; pnpm test:coverage:ci && sonar-scanner-npm'",
    "test": "node tests/eslint/capacitor-boundary.mjs && node --test tests/android-release.test.mjs tests/dependency-compatibility.test.mjs && vitest run",
    "test:integration": "playwright test",
    "test:integration:debug": "playwright test --debug",
    "test:integration:install": "playwright install chromium",
    "test:integration:install:ci": "playwright install --with-deps chromium",
    "test:integration:ui": "playwright test --ui",
    "test:pwa-update": "node tests/pwa-update/run.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:coverage:ci": "vitest run --coverage --reporter=default --reporter=junit --outputFile.junit=coverage/junit.xml",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "8.0.1",
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@capawesome/capacitor-google-sign-in": "0.1.4",
    "@dall-fit/types": "workspace:*",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@heroui/react": "^3.2.6",
    "@heroui/styles": "^3.2.6",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "^1.170.45",
    "@vercel/analytics": "^2.0.1",
    "axios": "^1.20.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-player": "^3.4.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^30.1.3",
    "msw": "^3.0.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "~2.0.0",
    "vitest": "^5.0.5",
    "workbox-window": "^7.4.1"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
