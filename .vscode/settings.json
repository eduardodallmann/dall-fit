{
  "files.eol": "\n",
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "eslint.useFlatConfig": true,
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact"
  ],
  "eslint.debug": true,
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "explorer.compactFolders": false,
}
